# Optional. Every key below can instead be saved on the web UI (Settings > API keys), where it is
# stored encrypted. A value here wins over a saved one. To use this file: copy it to .env (gitignored;
# never commit it) and fill in what you need.

# Optional: the encryption key for saved keys and settings (32 bytes, base64: openssl rand -base64 32).
# Without it jobalerts creates data/secret.key.
# JOBALERTS_SECRET_KEY=

# Your email, sent in the User-Agent so job-board operators can contact you
CONTACT_EMAIL=you@example.com

# ntfy: install the ntfy app, subscribe to this topic. Use a long random name.
NTFY_TOPIC=jobalerts-change-me-to-something-random
NTFY_TOKEN=

# AI fit scoring
ANTHROPIC_API_KEY=

# Home Assistant dashboard sensor over MQTT (the host and user can also be set on Settings > Connections).
# Use a dedicated broker login, not a Home Assistant user.
MQTT_HOST=
MQTT_USERNAME=jobalerts
MQTT_PASSWORD=

# Aggregator searches beyond your watch list (each runs once its key is set)
USAJOBS_API_KEY=
USAJOBS_EMAIL=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
RAPIDAPI_KEY=
# TheirStack: app.theirstack.com > Settings > API Keys (free plan: 200 jobs a month)
THEIRSTACK_API_KEY=
