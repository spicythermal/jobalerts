# Copy to .env and fill in. .env is gitignored; never commit it.

# Your email, sent in the User-Agent so job-board operators can contact you
CONTACT_EMAIL=you@example.com

# ntfy: install the ntfy app, subscribe to this topic. Use a long random name.
NTFY_TOPIC=jobalerts-change-me-to-something-random
NTFY_TOKEN=

# AI fit scoring (scoring.enabled: true in config.yaml)
ANTHROPIC_API_KEY=

# Home Assistant dashboard sensor over MQTT (homeassistant.enabled: true in config.yaml).
# Use a dedicated broker login, not a Home Assistant user.
MQTT_HOST=
MQTT_USERNAME=jobalerts
MQTT_PASSWORD=

# Aggregators (enable in config.yaml)
USAJOBS_API_KEY=
USAJOBS_EMAIL=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
RAPIDAPI_KEY=
# TheirStack: app.theirstack.com > Settings > API Keys (free plan: 200 jobs a month)
THEIRSTACK_API_KEY=
